# ── Flask ──────────────────────────────────────────────────────────────
# App factory entrypoint. Flask discovers create_app() automatically.
FLASK_APP=create_app

# Set to 1 locally for auto-reload and detailed error pages.
# Hardcoded to 0 in docker-compose.coolify.yml — do not override in production.
FLASK_DEBUG=1

# ── Server ─────────────────────────────────────────────────────────────
PORT=3101

# ── Data ───────────────────────────────────────────────────────────────
# Absolute path to the sibling spec-doc/ repository on this machine.
# Example (macOS):  SPEC_DOC_DIR=/Users/<you>/Projects/spec-doc
# Container local:  set to /data/spec-doc via compose bind-mount; leave blank here.
SPEC_DOC_DIR=

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Local Angular dev servers run on 4201 (app) and 4202 (storybook).
CORS_ORIGINS=http://localhost:4201,http://localhost:4202

# ── AI Provider ────────────────────────────────────────────────────────
# Valid values: claude | cli | mock
#   claude  — live Anthropic API (requires ANTHROPIC_API_KEY)
#   cli     — local Claude CLI subprocess
#   mock    — static fixture responses; use for local dev and CI smoke tests
CHAIN_PROVIDER=mock

# Required when CHAIN_PROVIDER=claude. Leave empty for mock/cli modes.
# Never commit a real key — add it to your local .env only.
ANTHROPIC_API_KEY=

# Optional override for the Anthropic API base URL. Used by tests to redirect
# SDK HTTP traffic to a stub server via monkeypatch.setenv. Leave blank in
# normal operation; the SDK falls back to its built-in default.
ANTHROPIC_BASE_URL=

# Executor model version injected into implementation guide prompts as the
# Co-Authored-By trailer. Defaults to the production model (claude-sonnet-4-5)
# when unset. Claude Code sets this automatically inside agent sessions.
CLAUDE_CODE_MODEL=

# ── Context Loader ─────────────────────────────────────────────────────
# Set to "mock" to bypass the real spec-doc context loader and serve static
# fixtures (used by tests). Leave blank for normal operation.
CONTEXT_PROVIDER=

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ───────────────────────────────────────────────────────────────
# 64-char hex. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# CRITICAL: same value across Core + all product services (shared JWT verification)
JWT_SECRET=

# ── Stripe ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs: STRIPE_PRICE_{PRODUCT}_{PLAN} — e.g. STRIPE_PRICE_OLL_PRO_MONTHLY
STRIPE_PRO_PRICE_ID=
STRIPE_PRICE_OLL_PRO_MONTHLY=
STRIPE_PRICE_OLL_PRO_YEARLY=
STRIPE_PRICE_HEADSHOT_CHF29_ONE_TIME=
STRIPE_PRICE_HEADSHOT_CHF49_ONE_TIME=
STRIPE_PRICE_HEADSHOT_CHF79_ONE_TIME=

# ── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=oll.am <hello@oll.am>
SITE_URL=https://oll.am

# ── Frontend ───────────────────────────────────────────────────────────
FRONTEND_URL=https://oll.am

# ── Deployment secrets ─────────────────────────────────────────────────
# COOLIFY_WEBHOOK=
# COOLIFY_TOKEN=
