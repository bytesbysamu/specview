# Copy this file to .env and fill in real values. .env is gitignored — never commit credentials.
# In production, Coolify supplies these (Settings → Environment Variables).
# Vars marked [boot-gate] are HARD-REQUIRED in APP_ENV=production or oll-core refuses to start.

# ── Database (Neon Postgres) ──────────────────────────────────────
# Neon console → project → Connection string. Format: postgresql://<user>:<pw>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))". Rotating invalidates all sessions.
JWT_SECRET=replace-with-64-char-hex-never-use-this        # [boot-gate]  (AUTH_JWT_SECRET falls back to this)
# AUTH_JWT_SECRET=                                         # optional explicit override

# ── Billing — Stripe (the oll.am account) ─────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx_or_sk_test_xxx              # required for billing
STRIPE_WEBHOOK_SECRET=whsec_xxx                           # [boot-gate]  (dev may use whsec_dev_dummy)
STRIPE_PRO_PRICE_ID=price_xxx                             # default Pro price
# Per-product/plan routing: STRIPE_PRICE_{PRODUCT}_{PLAN}
STRIPE_PRICE_OLL_PRO_MONTHLY=price_xxx
STRIPE_PRICE_OLL_PRO_YEARLY=price_xxx

# ── Email — Resend ────────────────────────────────────────────────
RESEND_API_KEY=re_xxx                                    # empty = email silently disabled
FROM_EMAIL=oll.am <onboarding@resend.dev>                # test sender until oll.am is verified on Resend
# After verifying oll.am on resend.com → FROM_EMAIL=oll.am <hello@oll.am> (can send to any customer)

# ── App / frontend / AI ───────────────────────────────────────────
APP_ENV=production
FRONTEND_URL=https://oll.am                              # magic-link + Stripe success/cancel redirect base
CORS_ORIGINS=https://oll.am                              # local: http://localhost:4200,http://localhost:8095
CHAIN_PROVIDER=claude                                    # cli/mock for dev; claude in prod
ANTHROPIC_API_KEY=sk-ant-xxx                             # required when CHAIN_PROVIDER=claude
