# ─────────────────────────────────────────────────────────────────────────────
# specview env — TEMPLATE (committed; no real secrets). Copy to .env for local.
# As of C2 specview is a CLIENT of core.oll.am: nginx proxies /api/auth|billing|
# email there, and specview's api keeps only the JWT-VALIDATION spine.
#
# CONVENTION (site/oll-am-env-secrets.html): same names everywhere, only VALUES
# differ (local=TEST, Coolify=LIVE). Live secrets ONLY in Coolify, never a file.
# Vars marked [boot-gate] are HARD-REQUIRED in APP_ENV=production.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production

# ══ SPINE — shared with oll-core (Coolify Shared Variables; drift = broken SSO) ═
# MUST be the same oll_core db Core writes users to (else require_auth 401s).
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-example-pooler.eu-central-1.aws.neon.tech/oll_core?sslmode=require
# IDENTICAL to oll-core's value. specview only VALIDATES tokens (Core issues them).
JWT_SECRET=replace-with-64-char-hex        # [boot-gate]  (AUTH_JWT_SECRET preferred; this is the alias)

# ══ PRODUCT — specview's own (Core has none of these) ═════════════════════════
CHAIN_PROVIDER=claude                      # cli/mock for dev; claude in prod
ANTHROPIC_API_KEY=sk-ant-xxx               # required when CHAIN_PROVIDER=claude
CORS_ORIGINS=https://app.specview.dev      # local: http://localhost:4200,http://localhost:8095
# Storage dirs (SPEC_DOC_DIR, PLUGIN_DIR, PROJECTS_DIR, GIT_REPOS_DIR) + CHAIN_AGENT
# /CONTEXT_PROVIDER have defaults in docker-compose.yml — override only if needed.

# ══ CORE-OWNED — dead in the client; REMOVE at C3 (see oll-am-specview-core-cleanup) ═
# Billing/email run on Core now; these are read only by the soon-to-be-deleted
# modules. Keep STRIPE_WEBHOOK_SECRET until C3 relaxes the boot-gate; the rest are
# already inert (their routes are proxied to Core and never execute here).
STRIPE_WEBHOOK_SECRET=whsec_dev_dummy       # [boot-gate] — last Stripe var standing until C3
# STRIPE_SECRET_KEY=        ← remove at C3   # Core owns billing
# STRIPE_PRO_PRICE_ID=      ← remove at C3
# RESEND_API_KEY=           ← remove at C3   # Core owns email
# FROM_EMAIL=               ← remove at C3
# FRONTEND_URL= / DEFAULT_PRODUCT=  ← remove at C3 (Core owns the magic-link redirect)

# ══ OPTIONAL (safe defaults; observability) ══════════════════════════════════
# SENTRY_DSN=                              # backend errors
# SENTRY_DSN_WEB=                          # frontend errors
# SENTRY_TRACES_SAMPLE_RATE=0.1
# LOG_LEVEL=info
# PORT=                                    # Coolify sets it; 12-factor
