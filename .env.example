# Copy this file to .env and fill in real values.
# .env is gitignored — never commit credentials.

# PostgreSQL connection string.
# Obtain from the Neon console: project > Connection Details > Connection string.
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-example-pooler.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require

# JWT signing secret used to sign and verify auth tokens.
# Generate a secure value with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Rotating this value invalidates all existing user sessions.
JWT_SECRET=replace-with-64-character-hex-string-never-use-this-value

# Comma-separated list of allowed CORS origins.
# Local dev: http://localhost:4200,http://localhost:8095
# Production: https://specview.app,https://www.specview.app
CORS_ORIGINS=http://localhost:4200,http://localhost:8095
