# ─────────────────────────────────────────────────────────────────────────────
# specview runtime env — TEMPLATE (committed; never put real secrets here).
# As of C2, specview is a CLIENT of core.oll.am for auth/billing/email — its
# nginx proxies /api/auth|billing|email there. specview's api keeps only the
# JWT-VALIDATION spine (it validates Core's token; it no longer issues them).
#
# STORAGE CONVENTION (same var NAMES everywhere — only VALUES differ):
#   • Local/dev  → copy to .env (gitignored). ALWAYS Stripe TEST values.
#   • Production → Coolify app env (Settings → Environment Variables). LIVE values.
#                  Live keys live ONLY in Coolify — never in a file.
#   • SHARED with oll-core (byte-identical or SSO breaks) → AUTH_JWT_SECRET +
#       DATABASE_URL ⇒ Coolify SHARED VARIABLES, referenced by BOTH apps.
#       (A drift here is exactly what broke SSO on 2026-06-28.)
# Vars marked [boot-gate] are HARD-REQUIRED in APP_ENV=production.
# ─────────────────────────────────────────────────────────────────────────────

# ── SHARED with oll-core (Coolify Shared Variables) ───────────────────────────
# Neon console → project → Connection string. MUST be the same oll_core db Core
# writes users to, or require_auth's user lookup 401s even with a valid token.
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-example-pooler.eu-central-1.aws.neon.tech/oll_core?sslmode=require
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))".
# IDENTICAL to oll-core's AUTH_JWT_SECRET. validate-only here (Core issues tokens).
JWT_SECRET=replace-with-64-char-hex-never-use-this        # [boot-gate] (AUTH_JWT_SECRET falls back to this)
# AUTH_JWT_SECRET=                                         # preferred explicit name; = Core's value

# ── Billing — Stripe (the oll.am account) ─────────────────────────────────────
#   ⚠️ TEST vs LIVE: the ONLY vars that differ by environment.
#   Local/dev = sk_test_ / test prices / test webhook. Prod = sk_live_ / LIVE.
#   NOTE: post-C2 the browser's billing calls proxy to Core, so in a fully
#   cleaned client these may move entirely to the oll-core app (see C3 plan).
STRIPE_SECRET_KEY=sk_test_...                            # ⚠️ prod: sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...                          # [boot-gate] (dev: whsec_dev_dummy)
STRIPE_PRO_PRICE_ID=price_...                            # default Pro price
STRIPE_PRICE_OLL_PRO_MONTHLY=price_...
STRIPE_PRICE_OLL_PRO_YEARLY=price_...

# ── Email — Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                                   # empty = email silently disabled
FROM_EMAIL=oll.am <onboarding@resend.dev>               # test sender until oll.am verified on Resend

# ── App / frontend / AI ───────────────────────────────────────────────────────
APP_ENV=production
FRONTEND_URL=https://app.specview.dev                   # magic-link + Stripe redirect base
CORS_ORIGINS=https://app.specview.dev                   # local: http://localhost:4200,http://localhost:8095
CHAIN_PROVIDER=claude                                   # cli/mock for dev; claude in prod
ANTHROPIC_API_KEY=sk-ant-xxx                            # required when CHAIN_PROVIDER=claude
